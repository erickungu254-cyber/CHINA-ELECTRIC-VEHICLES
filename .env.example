# PostgreSQL connection strings (pooled runtime URL; direct URL for Prisma migrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ev_china_global?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/ev_china_global?schema=public

# Optional server-side AI; never expose this as NEXT_PUBLIC_*
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional email delivery for verification/reset links (Resend)
RESEND_API_KEY=
EMAIL_FROM=E.V CHINA GLOBAL <onboarding@resend.dev>
APP_URL=http://localhost:3000
COMPANY_LEGAL_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=

# One-time admin bootstrap: supply only when running `npm run admin:bootstrap`
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# One-time staff provisioning: set only when running `npm run staff:create`
STAFF_EMAIL=
STAFF_NAME=
STAFF_ROLE=
STAFF_PASSWORD=
